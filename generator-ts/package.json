{
  "name": "nanopb-generator-ts",
  "version": "1.0.0-dev",
  "description": "TypeScript version of nanopb generator - Protocol Buffers to C code generator for embedded systems",
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "nanopb-generator": "dist/cli/main.js"
  },
  "scripts": {
    "build": "bun build ./src/cli/main.ts --outdir ./dist --target node",
    "dev": "bun run src/cli/main.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "protobuf",
    "nanopb",
    "embedded",
    "c-code-generator",
    "protocol-buffers"
  ],
  "author": "nanopb-ts contributors",
  "license": "MIT",
  "dependencies": {
    "protobufjs": "^7.2.5",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "bun-types": "1.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nanopb/nanopb-ts.git"
  },
  "bugs": {
    "url": "https://github.com/nanopb/nanopb-ts/issues"
  },
  "homepage": "https://jpa.kapsi.fi/nanopb/"
}
